# ------------------------------------------------------------------ доступ к API
# my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
# Строку сессии заполнять НЕ нужно: login.py сам сохранит её рядом с состоянием
# (в докере — /data/session.txt), а repost.py возьмёт оттуда. Ручной перенос этих
# ~350 символов в .env — главный источник ошибки `Incorrect padding`.
# Заполнять только если тома нет и сессию приходится носить руками, одной строкой.
TG_SESSION=
# На сервере проекта Telegram напрямую НЕ открывается (клиент падает с TimeoutError) —
# ходить надо через тот же SOCKS5, что у бэкенда в TELEGRAM_PROXY_URL (корневой .env).
# Локально с домашней машины обычно не нужен — оставить пустым.
TG_PROXY_URL=

# ---------------------------------------------------------------------- что и куда
# Точные id брать из `python repost.py --dialogs` — не угадывать.
# Допустимо: -1001234567890 | @username | https://t.me/c/1234567890/1
SRC_CHAT=
DST_CHAT=

# Контрольная сверка: точное название целевого канала, как оно видно в Telegram.
# Если открылся чат с другим названием — запуск падает, ничего не отправив.
# Оставлять заполненным: это главная страховка от промаха по id.
DST_TITLE_EXPECTED=

# --------------------------------------------------------------------- поведение
# history — только старые сообщения; live — только новые; both — сначала история, потом онлайн
MODE=both

# true  = ничего не отправляется, только печатается план (первый запуск делать так)
# false = боевой режим
DRY_RUN=true

# Одно сообщение-«канарейка» в цель перед первым переносом, чтобы глазами
# убедиться в правильном чате. Отправляется один раз за всё время.
SEND_CANARY=true

# Смена пары чатов после первого запуска запрещена; true — только осознанно.
ALLOW_RETARGET=false

# ------------------------------------------------------------------------- автор
# Приписывать имя отправителя первой строкой (жирным). Без этого копия выглядит так,
# будто всё написал владелец канала.
SHOW_AUTHOR=true

# Шаблон подписи; {name} — имя отправителя, \n — перевод строки.
# Например: {name} пишет:\n   или   От {name}:
AUTHOR_TEMPLATE={name}:\n

# ------------------------------------------------------------------------ контент
INCLUDE_MEDIA=true
INCLUDE_DOCUMENTS=true
ALBUMS=true

# ------------------------------------------------------------------------ история
# 0 = вся история. N = последние N сообщений (отправляются от старых к новым).
HISTORY_LIMIT=0
# Начать с сообщения после указанного id (0 = без ограничения).
HISTORY_MIN_ID=0
# Или с даты: 2026-01-31 либо 2026-01-31T10:00
HISTORY_SINCE=

# Пауза между отправками. Меньше 1500 мс на большой истории — риск FloodWait.
HISTORY_DELAY_MS=3000
LIVE_DELAY_MS=500

# ----------------------------------------------------------------------- служебное
# В докере путь примонтированного тома; локально можно ./state.db
STATE_DB=/data/state.db
LOG_LEVEL=INFO
