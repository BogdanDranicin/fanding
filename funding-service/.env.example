# PostgreSQL — используйте DATABASE_URL (Supabase/Render) ИЛИ отдельные переменные (локально)
# DATABASE_URL=postgresql://user:password@host:5432/db?sslmode=require
POSTGRES_USER=funding
POSTGRES_PASSWORD=changeme
POSTGRES_DB=funding
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Telegram
# Токен бота от @BotFather. Без него бот и уведомления отключены.
TELEGRAM_BOT_TOKEN=
# Username бота БЕЗ @ (например funding_alerts_bot). Без него страница
# «Настройки» не может выдать ссылку привязки (ошибка 503 bot not configured).
TELEGRAM_BOT_USERNAME=
# Прокси ТОЛЬКО для Telegram (api.telegram.org недоступен из РФ напрямую).
# Список через запятую; каждый — user:pass@host:port или полный URL со схемой
# (http://… или socks5://…). Бот пробует по порядку, пока один не сработает.
# Пусто = подключаться напрямую (сработает только там, где Telegram доступен).
# Пример: TELEGRAM_PROXY_URL=user:pass@1.2.3.4:9598,user:pass@1.2.3.5:9700
TELEGRAM_PROXY_URL=
# Админы — им и только им видны вкладки «Журнал» и «Скорость».
# Список через запятую: числовой chat_id и/или @username (регистр не важен).
# Роль выдаётся при /start в боте, поэтому после правки нужно один раз
# нажать /start в чате с ботом. Пусто = админов нет ни у кого.
# Пример: TELEGRAM_ADMINS=123456789,@my_username
TELEGRAM_ADMINS=

# HTTPS proxy for MOEX ISS (если iss.moex.com недоступен напрямую из Docker)
# Пример: HTTPS_PROXY=http://host.docker.internal:7890
HTTPS_PROXY=

# MOEX polling interval in milliseconds
MOEX_POLL_INTERVAL_MS=250

# Backend HTTP port
BACKEND_PORT=8080

# Log level: debug | info | warn | error
LOG_LEVEL=info

# ── Поиск роботов (страница «Роботы») ──────────────────────────────────────
# Сервис пишет ленту сделок по каждому тикеру и ищет повторяющиеся принты
# одного размера с ровным периодом.
ROBOTS_ENABLED=true
# Тикеры через запятую. Запись без префикса — акция основного режима (TQBR),
# с префиксом futures: — контракт FORTS. Пусто = список по умолчанию
# (ликвидные бумаги + валютные фьючерсы).
# Пример: ROBOTS_SYMBOLS=SBER,GAZP,LKOH,futures:USDRUBF
ROBOTS_SYMBOLS=
# Как часто опрашивается лента каждого тикера, мс. На точность тайминга не
# влияет (период считается по биржевым меткам сделок) — только на скорость
# появления робота на странице и на нагрузку на ISS.
ROBOTS_POLL_MS=3000
