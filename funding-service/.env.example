# PostgreSQL — используйте DATABASE_URL (Supabase/Render) ИЛИ отдельные переменные (локально)
# DATABASE_URL=postgresql://user:password@host:5432/db?sslmode=require
POSTGRES_USER=funding
POSTGRES_PASSWORD=changeme
POSTGRES_DB=funding
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Telegram
# Токен бота от @BotFather. Без него бот и уведомления отключены.
TELEGRAM_BOT_TOKEN=
# Username бота БЕЗ @ (например funding_alerts_bot). Без него страница
# «Настройки» не может выдать ссылку привязки (ошибка 503 bot not configured).
TELEGRAM_BOT_USERNAME=
# Прокси ТОЛЬКО для Telegram, на случай когда api.telegram.org недоступен.
# На боевом сервере он НЕ нужен: IPv4 к Telegram хостер блокирует, но IPv6 открыт,
# и сеть funding-net поднята с enable_ipv6 — бот ходит напрямую по IPv6.
# Список через запятую; каждый — user:pass@host:port или полный URL со схемой
# (http://… или socks5://…). Бот пробует по порядку, пока один не сработает.
# Пример: TELEGRAM_PROXY_URL=user:pass@1.2.3.4:9598,user:pass@1.2.3.5:9700
TELEGRAM_PROXY_URL=
# Админы — им и только им видны вкладки «Журнал» и «Скорость».
# Список через запятую: числовой chat_id и/или @username (регистр не важен).
# Роль выдаётся при /start в боте, поэтому после правки нужно один раз
# нажать /start в чате с ботом. Пусто = админов нет ни у кого.
# Пример: TELEGRAM_ADMINS=123456789,@my_username
TELEGRAM_ADMINS=

# HTTPS proxy for MOEX ISS (если iss.moex.com недоступен напрямую из Docker)
# Пример: HTTPS_PROXY=http://host.docker.internal:7890
HTTPS_PROXY=

# MOEX polling interval in milliseconds
MOEX_POLL_INTERVAL_MS=250

# Backend HTTP port
BACKEND_PORT=8080

# Log level: debug | info | warn | error
LOG_LEVEL=info

# ── Поиск роботов (страница «Роботы») ──────────────────────────────────────
# Сервис пишет ленту сделок по каждому тикеру и ищет повторяющиеся принты
# одного размера с ровным периодом.
ROBOTS_ENABLED=true
# Тикеры через запятую — сужают отбор. Пусто = правила по умолчанию: все акции
# основного режима TQBR, валютные и индексные фьючерсы (MIX, MXI, IMOEXF) и
# вечные контракты на акции (SBERF, GAZPF).
# Ленты рынков опрашиваются целиком в любом случае: ISS отдаёт сделки всех
# инструментов рынка одним запросом, поэтому список влияет на разбор, а не на
# нагрузку. Пример: ROBOTS_SYMBOLS=SBER,GAZP,LKOH,USDRUBF
ROBOTS_SYMBOLS=
# Как часто опрашивается лента каждого рынка, мс. На точность тайминга не
# влияет (период считается по биржевым меткам сделок) — только на скорость
# появления робота на странице.
ROBOTS_POLL_MS=3000
# Токен T-Invest API (личный кабинет Т-Инвестиций, достаточно read-only).
# Даёт поиску роботов поток обезличенных сделок в реальном времени: публичная
# лента MOEX ISS приходит с задержкой ровно в 15 минут, брокерский поток — за
# секунду-полторы. Пусто — сбор работает только по ISS, с этой задержкой.
# ISS опрашивается в любом случае: он закрывает историю окна анализа и остаётся
# запасным источником, если поток оборвётся.
TINVEST_TOKEN=

# ── Push-уведомления (сигнал в фоне) ───────────────────────────────────────
# Ими сигнал доходит до вкладки, которую браузер заморозил, до свёрнутого окна
# и до закрытого браузера. Пусто — push выключен, страница его не предлагает.
#
# Пару ключей печатает `go run ./cmd/vapidkeys` (запускается один раз).
# Менять её без нужды нельзя: открытый ключ вшит в каждую выданную браузером
# подписку, и с новой парой все подписки разом перестают приниматься —
# пользователям придётся включать уведомления заново.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Контакт владельца сервиса: mailto:… или адрес сайта. Push-сервис требует его
# в подписи и по нему ищет, кому жаловаться.
VAPID_SUBJECT=
# Прокси до push-сервиса, если он недоступен напрямую (та же беда, что с
# api.telegram.org). Пусто — соединяемся сами.
PUSH_PROXY_URL=

# Приём сообщений каналов со сделками от tg-repost (вкладка «Сделки», только
# для админов). Тот же секрет — в TRADES_TOKEN у tg-repost. Пусто — приём выключен.
TRADES_INGEST_TOKEN=
